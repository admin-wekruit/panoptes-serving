# Copy to .env and fill in. Never commit .env.

# --- provider credentials (cloud mode) ---
GEMINI_API_KEY=          # VLM: orientation / detection / climb review / chat
FAL_KEY=                 # SAM 3 (default backend)
REPLICATE_API_TOKEN=     # MapAnything (default backend)
HF_TOKEN=                # HuggingFace pulls (gated facebook/sam3 for self-hosting)

# --- backend switches (see docs/BACKENDS.md; defaults shown) ---
# SAM3_BACKEND=fal            # fal | modal | http
# GEOMETRY_BACKEND=replicate  # replicate | modal | http
# MOGE_BACKEND=modal          # modal | replicate | http
# SAM3_HTTP_URL=http://<gpu>:8801/sam3
# GEOMETRY_HTTP_URL=http://<gpu>:8802/geometry
# MOGE_HTTP_URL=http://<gpu>:8803/moge

# --- tuning ---
# EHS_SAM_CONCURRENCY=4

# --- model services on the GPU boxes (docs/BACKENDS-v1.md, serving/registry.yaml, make up GPU=a|b) ---
PANOPTES_SERVICE_API_KEY=             # X-API-Key on every request; a service refuses to start without it (PANOPTES_SERVICE_ALLOW_NO_KEY=1 to override)
WEIGHTS=/srv/panoptes-weights         # fetch_weights*.py --cache DIR on the box, mounted read-only at /weights (SHA-256-checked at start)
# PANOPTES_SERVICE_MAX_QUEUE=4         # 429 busy when queue_depth >= this
# PANOPTES_SERVICE_CACHE_DIR=/cache    # finished results by input_sha256 (the compose files mount a volume there)
# PANOPTES_RESULT_BUCKET=panoptes-results/prefix   # + AWS_ENDPOINT_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY: result_uri instead of result_b64
# PANOPTES_SERVICE_SYNC_TIMEOUT_S=600
# GPU_A_DEVICE=0  GPU_B_DEVICE=1       # nvidia device ids of the two compose stacks (0 and 0 on two one-card VMs)
# PANOPTES_ROMA_DEVICE=auto            # geometry-mvs: cuda | cpu | auto (the shipped /opt/geometry venv is the CPU torch build)
# --- client side (ehs_spatial/providers; docs/BACKENDS-v1.md) ---
# SAM3D_BACKEND=http  SAM3D_HTTP_URLS=http://<gpu-a>:8805
# GEOMETRY_MVS_BACKEND=http  GEOMETRY_MVS_HTTP_URLS=http://<gpu-b>:8804
# PANOPTES_SERVICE_TIMEOUT_S=1800  PANOPTES_SERVICE_RETRIES=3
