# Panoptes .env template: copy to .env and fill in. Never commit .env. One configuration surface: every key has a
# comment and its default; nothing else in the code holds a machine path.
# (The cloud-mode credentials of the one-POST services stay in .env.example; the storage / publication sections are WP1 / WP5.)

# ===== Model services, client side (docs/BACKENDS-v1.md "Client side"; read by ehs_spatial/providers/*) =====
# Where each GPU model runs:
#   http   the model services on the GPU machine(s) (serving/, one container per model)
#   local  the same function bodies in this process through ehs-spatial/scripts/onprem/run_stage.py's stub
#          (needs the GPU, PANOPTES_WORKCELL and the weights mirror WEIGHTS on this machine)
#   modal  our Modal apps (the default when unset: today's path, as `modal run` runs the research scripts)
SAM3D_BACKEND=http                       # http | local | modal   S4a: SAM 3D Objects candidates (providers/sam3d.py)
GEOMETRY_MVS_BACKEND=http                # http | local | modal   S2a: RoMa + DA3-BASE start + MoGe-3 (providers/geometry_mvs.py)

# Service roots, comma-separated, one entry per GPU: the provider polls each /healthz and sends to the smallest
# queue_depth (two A100s = two entries). No trailing path: the provider appends /v1/<model>, /v1/<model>/jobs, /v1/jobs/{id}.
SAM3D_HTTP_URLS=http://10.21.72.251:8805
GEOMETRY_MVS_HTTP_URLS=http://10.21.72.251:8804

PANOPTES_SERVICE_API_KEY=                # sent as X-API-Key on every request; the services' own .env holds the same value
PANOPTES_SERVICE_TIMEOUT_S=1800          # per request and per job wait, seconds (default 1800)
PANOPTES_SERVICE_RETRIES=3               # retries with exponential backoff on connection errors, 429 busy and 503 only;
                                         # never on model_error / bad_input / unauthorized (default 3)

# local backend only (env.sh's names):
# PANOPTES_WORKCELL=../ehs-spatial       # the ehs-spatial checkout (default: next to this repo)
# WEIGHTS=research/module-swap-2026-10-07/data/weights   # scripts/onprem/fetch_weights*.py --cache DIR (sha256-checked)

# The existing one-POST services (docs/BACKENDS.md) keep their own switches:
# SAM3_BACKEND=fal | modal | http        SAM3_HTTP_URL=http://<gpu>:8801/sam3
# GEOMETRY_BACKEND=replicate | modal | http   GEOMETRY_HTTP_URL=http://<gpu>:8802/geometry
# MOGE_BACKEND=modal | replicate | http  MOGE_HTTP_URL=http://<gpu>:8803/moge

# ===== Pipeline (research/module-swap-2026-10-07/env.sh; `panoptes run` sources it, values set here win) =====
# SWAP_SCRATCH=research/module-swap-2026-10-07/data   # frozen inputs + every output; swap-runs/<cell>/ledger.json
# PANOPTES_RUNS=$SWAP_SCRATCH/runs       # lucida-replica-01 (090), bor1-030-01 (030)
# PY=.venv/bin/python                    # the interpreter the step scripts run with
# MODAL_RUN="$PY $PANOPTES_WORKCELL/scripts/onprem/run_stage.py --weights $WEIGHTS"   # how `modal run` scripts are run;
#                                        # `panoptes` drops --weights when $WEIGHTS has no manifest.json (CPU-only flow machine)
# PG=/usr/lib/postgresql/16/bin          # pg_ctl / pg_isready of the platform database (S7)
